<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InversionEnPozo.Movil.VistasModelos"
             x:Class="InversionEnPozo.Movil.Vistas.InversionistaMainPage"
             Title="Panel de Inversionista">

    <Grid RowDefinitions="Auto, *" Padding="20">
        <!-- Encabezado -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,0,0,15">
            <Label Text="Oportunidades de Inversión" FontSize="22" FontAttributes="Bold" TextColor="#1E3A8A"/>
            <Label Text="Explora proyectos inmobiliarios en pozo fondeados con Blockchain." FontSize="14" TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Lista de Proyectos -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Proyectos}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="10" Padding="15" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="16" TextColor="#374151"/>
                            <Label Text="{Binding Descripcion}" FontSize="13" TextColor="DimGray"/>

                            <HorizontalStackLayout Spacing="10">
                                <Label Text="Presupuesto:" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding CostoTotal, StringFormat='${0:N0}'}" FontSize="12" FontAttributes="Bold" TextColor="#2563EB"/>
                            </HorizontalStackLayout>

                            <!-- Botón para invertir -->
                            <Button Text="Invertir en este Proyecto" 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:InversionistaViewModel}}, Path=InvertirCommand}"
                                    CommandParameter="{Binding}"
                                    BackgroundColor="#10B981" 
                                    TextColor="White" 
                                    HeightRequest="40" 
                                    Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
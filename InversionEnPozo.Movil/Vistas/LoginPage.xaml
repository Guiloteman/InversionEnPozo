<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InversionEnPozo.Movil.VistasModelos"
             x:Class="InversionEnPozo.Movil.Vistas.LoginPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,0,30,10" 
                             Spacing="4" 
                             VerticalOptions="Start" 
                             MaximumWidthRequest="450"
                             HorizontalOptions="Center">

            <!-- Logo equilibrado para que no genere tanto espacio vacío -->
            <Image Source="logo.png" 
                   WidthRequest="240" 
                   HeightRequest="240" 
                   Aspect="AspectFit" 
                   HorizontalOptions="Center" 
                   Margin="0,-10,0,-10" />

            <!-- Campo Nombre Completo (Solo visible al registrarse) -->
            <VerticalStackLayout Spacing="2" IsVisible="{Binding EsRegistro}">
                <Label Text="Nombre Completo" FontSize="12" TextColor="DarkGray"/>
                <Entry Placeholder="Ej. Juan Pérez" 
                       Text="{Binding NombreCompleto}" />
            </VerticalStackLayout>

            <!-- Campo Email -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Correo Electrónico" FontSize="12" TextColor="DarkGray"/>
                <Entry Placeholder="correo@ejemplo.com" 
                       Text="{Binding Email}" 
                       Keyboard="Email"/>
            </VerticalStackLayout>

            <!-- Campo Password con botón de ver/ocultar -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Contraseña" FontSize="12" TextColor="DarkGray"/>

                <Grid ColumnDefinitions="*, Auto">
                    <!-- IsPassword en true muestra puntos negros, en false muestra el texto plano -->
                    <Entry Grid.Column="0"
                           Placeholder="••••••••" 
                           Text="{Binding Password}" 
                           IsPassword="{Binding OcultarPassword}" 
                           VerticalOptions="Center"/>

                    <!-- Botón del "ojito" en su propia columna -->
                    <Button Grid.Column="1"
                            Text="{Binding IconoOjo}" 
                            Command="{Binding AlternarVerPasswordCommand}"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            FontSize="18"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Margin="5,0,0,0"
                            Padding="10,0"
                            HeightRequest="40"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Selector de Perfil (Solo visible al registrarse) -->
            <VerticalStackLayout Spacing="2" IsVisible="{Binding EsRegistro}">
                <Label Text="Tipo de Usuario" FontSize="12" TextColor="DarkGray"/>
                <Picker ItemsSource="{Binding ListaPerfiles}" 
                        SelectedItem="{Binding PerfilSeleccionado}" />
            </VerticalStackLayout>

            <!-- Botón de Acción Principal (Login / Registro) -->
            <Button Text="{Binding TextoBotonPrincipal}" 
                    Command="{Binding EjecutarAccionCommand}" 
                    BackgroundColor="#2563EB" 
                    TextColor="White" 
                    FontAttributes="Bold"
                    HeightRequest="45"
                    Margin="0,5,0,0"/>

            <Button Text="🔑 Ingresar con Huella Digital"
                    Command="{Binding AutenticarBiometricoCommand}"
                    BackgroundColor="#37474F"
                    TextColor="White"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                       IsVisible="{Binding IsBusy}" 
                       Color="Purple" 
                       HeightRequest="50" 
                       WidthRequest="50" 
                       HorizontalOptions="Center" />

            <!-- Botón Alternar Modo -->
            <Button Text="{Binding TextoAlternativo}" 
                    Command="{Binding CambiarModoCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="#2563EB" 
                    FontSize="13"
                    HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InversionEnPozo.Movil.VistasModelos"
             x:Class="InversionEnPozo.Movil.Vistas.ConstructoraMainPage"
             Title="Panel de Constructora">

    <Grid RowDefinitions="Auto, *">
        <!-- Encabezado de bienvenida -->
        <VerticalStackLayout Grid.Row="0" BackgroundColor="#1E3A8A" Padding="20" Spacing="5">
            <Label Text="¡Panel de Constructora!" FontSize="22" FontAttributes="Bold" TextColor="White"/>
            <Label Text="Gestiona tus desarrollos y atrae inversionistas." FontSize="14" TextColor="#E0E7FF"/>
        </VerticalStackLayout>

        <!-- Contenido principal -->
        <ScrollView Grid.Row="1" Padding="20">
            <VerticalStackLayout Spacing="15">
                <!-- Botón enlazado al comando del ViewModel -->
                <Button Text="+ Publicar Nuevo Proyecto" 
                        Command="{Binding IrANuevoProyectoCommand}"
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HeightRequest="45"/>

                <Label Text="Mis Proyectos Activos" FontSize="18" FontAttributes="Bold" TextColor="#1E3A8A" Margin="0,10,0,0"/>

                <Frame BackgroundColor="White" BorderColor="#E5E7EB" CornerRadius="10" Padding="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="" FontAttributes="Bold" FontSize="16" TextColor="#374151"/>
                        <Label Text="" FontSize="13" TextColor="Gray"/>
                        <Button Text="" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ConstructoraViewModel}}, Path=IrADetalleProyectoCommand}"
                                BackgroundColor="Transparent" TextColor="#2563EB" BorderColor="#2563EB" BorderWidth="1" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>